# Copy to .env locally; never commit real credentials.
SMART_TV_BIND=127.0.0.1
IMMICH_URL=http://host.docker.internal:2283/api/
IMMICH_API_KEY=replace-with-dedicated-read-only-key
# Comma-separated album UUIDs from the Immich album URLs. Empty exposes nothing.
IMMICH_ALBUM_IDS=replace-with-album-uuid
# Home Assistant (settings overlay only): the approved API URL ending in /api/ and its exact IP.
# The access token is entered on the administrator settings page, never here.
SMART_TV_HA_TARGETS=http://10.0.0.11:8123/api/
SMART_TV_HA_ADDRESSES=10.0.0.11
WEATHER_LATITUDE=32.7767
WEATHER_LONGITUDE=-96.7970
